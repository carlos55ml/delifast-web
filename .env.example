# Copia este fichero a .env.local (no se sube a git).

# API Spring Boot (DeliFast_Backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase (Auth, Realtime y Storage): URL y clave anon (pública) del proyecto delifast-dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Desarrollo sin backend: el simulador responde en el navegador con el mismo contrato
# (docs/api/openapi.yaml). Ponlo a false para usar la API real.
NEXT_PUBLIC_API_MOCK=true

# Desarrollo sin Supabase: sesión fija de administrador, sin login. Nunca en producción.
NEXT_PUBLIC_AUTH_MOCK=false
